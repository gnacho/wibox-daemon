[Unit]
Description=Wibox doorbell daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wibox
EnvironmentFile=/etc/wibox-daemon.conf
ExecStart=/usr/local/bin/wibox-daemon
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
